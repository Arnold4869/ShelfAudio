{
  "appId": "com.arnold.shelfaudio",
  "appName": "悦耳",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "backgroundColor": "#0f0d20"
  },
  "plugins": {
    "NativeAudio": {
      "hls": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "backgroundColor": "#0f0d20"
}
